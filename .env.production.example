# ==========================================================
# Alpha India Production Environment Configuration
# Copy this file to .env on your EC2 instance:
#   cp .env.production.example .env
# ==========================================================

# 1. Database Credentials (PostgreSQL 16 Container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GenerateStrongPassword2026!
POSTGRES_DB=alpha_india

# 2. Application Secrets
# Generate a random 64-char key with: openssl rand -hex 32
SECRET_KEY=e83a4f6d90bc128f4a7c5b6e2d1a3f5c7b9e0a2d4f6a8c1e3b5d7f9a1c3e5b7d

# 3. Public Frontend API Base URL
# This is baked into the Next.js client bundle to query the backend
NEXT_PUBLIC_API_URL=https://api.ipodesk.shop

# 4. Domain & SSL Settings
DOMAIN_NAME=ipodesk.shop
CERTBOT_EMAIL=admin@ipodesk.shop

# 5. Telegram Alerts & Telemetry (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# 6. Operational Controls
APP_ENV=production
NSE_USE_CURL_CFFI=true
WORKER_POLL_INTERVAL_SECONDS=60
