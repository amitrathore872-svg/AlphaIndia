# =========================================================================
# Alpha India Environment Configuration Template
# Copy this file to backend/.env and update credentials for your environment
# =========================================================================

# Database Connection (PostgreSQL Production / Staging)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/alpha_india

# SQL Echo / Query Debugging
DEBUG_SQL=false

# Application Environment (development, staging, production)
APP_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Cache (Standalone or Cluster for sub-millisecond caching)
REDIS_URL=redis://localhost:6379/0

# Secret Key for JWT Authentication & Encryption
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-key-in-production

# External Telemetry & Alerting (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Background Workers & Schedulers
ENABLE_BACKGROUND_WORKERS=true
ENABLE_AUTONOMOUS_ENGINE=true
ENABLE_VELOCITY_SCHEDULER=true
ENABLE_CUP_HANDLE_SCHEDULER=false
ENABLE_PATTERN_SCHEDULER=false
ENABLE_EARLY_STAGE_SCHEDULER=false
ENABLE_SCREENER_SCHEDULER=false
ENABLE_MF_DIP_SCHEDULER=false
WORKER_POLL_INTERVAL_SECONDS=60
NSE_USE_CURL_CFFI=true

# Dhan Broker API Integration (Live Intraday Execution & Historical Feeds)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# 5paisa Market Feed Integration (Optional)
FIVEPAISA_APP_NAME=
FIVEPAISA_APP_SOURCE=
FIVEPAISA_USER_ID=
FIVEPAISA_PASSWORD=
FIVEPAISA_USER_KEY=
FIVEPAISA_ENCRYPTION_KEY=
FIVEPAISA_PIN=
FIVEPAISA_CLIENT_CODE=
FIVEPAISA_TOTP_KEY=
FIVEPAISA_ACCESS_TOKEN=

